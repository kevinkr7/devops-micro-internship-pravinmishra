#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Commit Hook — Safety Net for DMI Cohort 3
# Enforces zero committed secrets, bans oversized files (>1MB), and warns on debug code.
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "==> Running Git Pre-Commit Safety Checks..."

EXIT_CODE=0

# 1. Block hardcoded AWS Access Keys and common API tokens in staged diff
# Matches standard AWS Access Key IDs (AKIA + 16 alphanumeric characters)
if git diff --cached --name-only | xargs -r grep -E -n "AKIA[0-9A-Z]{16}" /dev/null 2>/dev/null; then
    echo -e "${RED}[BLOCKED] Detected hardcoded AWS Access Key ID in staged changes!${NC}"
    echo "Secrets must never be committed to Git. Use environment variables or AWS Secrets Manager."
    EXIT_CODE=1
fi

# Matches GitHub Personal Access Tokens and OAuth tokens
if git diff --cached --name-only | xargs -r grep -E -n "(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{36,}" /dev/null 2>/dev/null; then
    echo -e "${RED}[BLOCKED] Detected GitHub Personal Access / OAuth Token in staged changes!${NC}"
    EXIT_CODE=1
fi

# 2. Block files larger than 1MB (1048576 bytes)
MAX_SIZE=1048576
for file in $(git diff --cached --name-only --diff-filter=ACM); do
    if [ -f "$file" ]; then
        FILE_SIZE=$(wc -c <"$file")
        if [ "$FILE_SIZE" -gt "$MAX_SIZE" ]; then
            echo -e "${RED}[BLOCKED] File '$file' exceeds maximum allowed size of 1MB ($FILE_SIZE bytes)!${NC}"
            echo "Consider using Git LFS or storing large binary assets in an S3 bucket."
            EXIT_CODE=1
        fi
    fi
done

# 3. Warn on leftover debug statements
DEBUG_MATCHES=$(git diff --cached | grep -E "^\+[[:space:]]*(console\.log|print\(DEBUG|debugger;)" || true)
if [ -n "$DEBUG_MATCHES" ]; then
    echo -e "${YELLOW}[WARNING] Staged changes contain potential debug statements:${NC}"
    echo "$DEBUG_MATCHES"
fi

if [ $EXIT_CODE -ne 0 ]; then
    echo -e "${RED}Pre-commit checks FAILED. Commit aborted.${NC}"
    exit 1
fi

echo -e "${GREEN}Pre-commit checks passed cleanly.${NC}"
exit 0

